# RailCast — Environment Variables
# Copy this file to .env and adjust as needed.
# .env is gitignored — never commit real secrets.
#
# Nothing in this file is required to run RailCast locally. Both upstream data
# sources are keyless, so `node server/src/index.js` + `npm run dev` works with
# no .env at all; every value below has a working default.

# ── Backend ───────────────────────────────────────────────────────────────────
# Port the RailCast Node.js backend (server/src/index.js) listens on.
# The Vite dev proxy expects 3001 — change both if you change this.
BACKEND_PORT=3001

# Interface the backend binds to. 0.0.0.0 accepts LAN connections (useful for
# testing on a phone); set to 127.0.0.1 to restrict to this machine.
BACKEND_HOST=0.0.0.0

# ── Frontend → backend wiring ─────────────────────────────────────────────────
# Where the Vite frontend finds the RailCast backend API.
# Leave EMPTY during local development — the proxy in vite.config.ts forwards
# /api/* to http://localhost:3001 automatically.
# In production, set this to the backend's deployed origin, e.g.:
#   VITE_API_BASE_URL=https://railcast-backend.your-domain.com
VITE_API_BASE_URL=

# ── Upstream data sources (no API keys required) ──────────────────────────────
# RailCast joins two keyless public feeds; see server/src/services/.
#
#   erail.in    timetables, station codes, per-stop coordinates, distances.
#               Cached 24h (server/src/services/erailClient.js) — a published
#               timetable changes a couple of times a year.
#
#   rappid.in   today's running status: per-stop delays and actual times.
#               Cached 3 min (server/src/services/trainScraper.js), matching
#               the feed's own refresh cadence.
#
# NOTE ON NTES: the official National Train Enquiry System endpoints at
# enquiry.indianrail.gov.in are NOT used, because they are currently serving an
# outage notice ("Due to some technical activity this site will be un-available
# for some time") on every path, REST endpoints included. They also respond
# with bare-LF headers that Node's HTTP parser rejects outright unless
# `insecureHTTPParser` is set. If NTES returns to service, it belongs behind
# the same interface as erailClient.js — nothing else would need to change.

# Train NUMBERS shown on the search page before the user types anything.
# Numbers only: every name, route, timing and delay is fetched live.
# Comma-separated; leave unset for the default set.
# BROWSE_TRAIN_IDS=12301,12302,12951,12952,12002

# How often (seconds) the backend refreshes the browse list in the background.
# Requests are always served from the warm snapshot, never blocked on upstream.
BROWSE_REFRESH_SECONDS=60

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of origins allowed to call the backend.
# "*" (the default) allows any origin, which is fine for local development.
# In production, pin this to your deployed frontend:
#   ALLOWED_ORIGINS=https://railcast.your-domain.com
ALLOWED_ORIGINS=*

# ── Diagnostics ───────────────────────────────────────────────────────────────
# Set to "true" to log every backend request with its status and duration.
LOG_REQUESTS=false

# ── Maps ──────────────────────────────────────────────────────────────────────
# Not required — RailCast uses Leaflet with free OpenStreetMap and Esri tiles.
# Add a Google Maps key here only if you switch MapContainer to Google Maps.
VITE_GOOGLE_MAPS_API_KEY=

# ── WebSockets (future) ───────────────────────────────────────────────────────
# Unused in the current polling architecture. Reserved for a future push
# upgrade.
VITE_WS_URL=
